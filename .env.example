# Template only. Copy to .env and replace every CHANGE_ME value locally.
# Never add passwords, tokens, API keys, or real private endpoints here.

# Kafka connection and bounded single-broker policy.
KAFKA_HOST_PORT=CHANGE_ME
KAFKA_BOOTSTRAP_SERVERS=CHANGE_ME
KAFKA_TOPIC=CHANGE_ME
KAFKA_TOPIC_PARTITIONS=CHANGE_ME
KAFKA_RETENTION_MS=CHANGE_ME
KAFKA_RETENTION_BYTES=CHANGE_ME
KAFKA_LOG_SEGMENT_BYTES=CHANGE_ME
KAFKA_COMPRESSION_TYPE=CHANGE_ME
KAFKA_PLAYER_COUNT_TOPIC=CHANGE_ME
KAFKA_PLAYER_COUNT_TOPIC_PARTITIONS=CHANGE_ME

# Steam producer cadence and safety limits.
STREAM_POLL_INTERVAL_SECONDS=CHANGE_ME
STREAM_MIN_POLL_INTERVAL_SECONDS=CHANGE_ME
STREAM_REQUEST_DELAY_SECONDS=CHANGE_ME
STREAM_MAX_PAGES_PER_GAME=CHANGE_ME
STREAM_MAX_ACTIVE_GAMES=CHANGE_ME
STREAM_MIN_FREE_GB=CHANGE_ME
STREAM_BOOTSTRAP_SOURCE=CHANGE_ME
STREAM_BOOTSTRAP_MAX_IDS_PER_GAME=CHANGE_ME
HADOOP_NAMENODE_CONTAINER=CHANGE_ME

# Player-count producer cadence and safety limits.
PLAYER_COUNT_POLL_INTERVAL_SECONDS=CHANGE_ME
PLAYER_COUNT_MIN_POLL_INTERVAL_SECONDS=CHANGE_ME
PLAYER_COUNT_REQUEST_DELAY_SECONDS=CHANGE_ME
PLAYER_COUNT_MAX_ACTIVE_GAMES=CHANGE_ME
PLAYER_COUNT_API_MAX_ATTEMPTS=CHANGE_ME

# Spark runtime.
STREAM_SPARK_TRIGGER_INTERVAL=CHANGE_ME
STREAM_WATERMARK_DELAY=CHANGE_ME
STREAM_MAX_OFFSETS_PER_TRIGGER=CHANGE_ME
STREAM_SPARK_SHUFFLE_PARTITIONS=CHANGE_ME
STREAM_AVAILABLE_NOW=CHANGE_ME
HDFS_DEFAULT_FS=CHANGE_ME
STREAM_HDFS_REPLICATION=CHANGE_ME

# Player-count Spark runtime.
PLAYER_COUNT_SPARK_TRIGGER_INTERVAL=CHANGE_ME
PLAYER_COUNT_WATERMARK_DELAY=CHANGE_ME
PLAYER_COUNT_MAX_OFFSETS_PER_TRIGGER=CHANGE_ME
PLAYER_COUNT_AVAILABLE_NOW=CHANGE_ME

# MongoDB realtime serving (optional; disabled preserves Streaming V1 behavior).
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=steam_analytics
MONGO_REALTIME_ENABLED=false
MONGO_RECENT_REVIEWS_COLLECTION=recent_reviews
MONGO_REALTIME_METRICS_COLLECTION=realtime_game_metrics
MONGO_PLAYER_COUNT_ENABLED=false
MONGO_PLAYER_COUNT_LATEST_COLLECTION=player_count_latest

# Optional fixture/E2E overrides; keep unset in the production .env.
# KAFKA_TOPIC=CHANGE_ME
# STREAM_HDFS_ROOT=CHANGE_ME
# STREAM_CHECKPOINT_ROOT=CHANGE_ME
# PLAYER_COUNT_HDFS_ROOT=CHANGE_ME
# PLAYER_COUNT_CHECKPOINT_ROOT=CHANGE_ME

# Spark MLlib V1 dynamic Gold batch retraining.
ML_INPUT_PATH=/steam/gold/base
ML_MODEL_ROOT=/steam/models/mllib/v1
ML_PREDICTIONS_PATH=/steam/ml/mllib/v1/test_predictions
ML_EVIDENCE_DIR=evidence/ml
ML_SHUFFLE_PARTITIONS=4
