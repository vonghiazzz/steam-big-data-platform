{
  "version": 1,
  "qualification": {
    "app_type": "game",
    "min_release_age_days": 30,
    "min_total_reviews": 2000,
    "require_metadata": true,
    "require_review_endpoint": true,
    "min_playtime_minutes": null
  },
  "onboarding": {
    "target_reviews_per_game": 2000,
    "max_new_games_per_cycle": 10
  },
  "discovery": {
    "frequency": "WEEKLY"
  },
  "catalog_refresh": {
    "enabled": true,
    "page_size": 50,
    "max_pages": 4,
    "request_delay_seconds": 0.8
  },
  "retry": {
    "max_attempts": 3,
    "exponential_backoff": true
  }
}
